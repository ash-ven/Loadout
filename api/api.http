@base = http://localhost:3000

### Health
GET {{base}}/api/health

### Crea oggetto - caso giusto
POST {{base}}/api/oggetti
Content-Type: application/json

{
  "nome": "Borraccia termica",
  "categoria": "cucina",
  "peso_g": 350
}
### Crea oggetto - dati sbagliati (atteso 400)
POST {{base}}/api/oggetti
Content-Type: application/json

{
  "nome": "",
  "categoria": "astronave",
  "peso_g": 0,
  "utente_id": 2
}

### Crea oggetto - duplicato (atteso 409)
POST {{base}}/api/oggetti
Content-Type: application/json

{
  "nome": "Borraccia termica",
  "categoria": "cucina",
  "peso_g": 350
}
### Crea oggetto - peso con la virgola
POST {{base}}/api/oggetti
Content-Type: application/json

{
  "nome": "Moschettone",
  "categoria": "attrezzatura",
  "peso_g": 2.5
}
### Modifica oggetto - caso giusto (atteso 200)
PUT {{base}}/api/oggetti/16
Content-Type: application/json

{
  "nome": "Borraccia termica",
  "categoria": "cucina",
  "peso_g": 380,
  "is_preferito": true,
  "note": "Tiene caldo 12 ore"
}

### Modifica oggetto - id inesistente (atteso 404)
PUT {{base}}/api/oggetti/999
Content-Type: application/json

{
  "nome": "Fantasma",
  "categoria": "altro",
  "peso_g": 10
}

### Modifica oggetto - dati sbagliati E id inesistente (atteso 400)
PUT {{base}}/api/oggetti/999
Content-Type: application/json

{
  "nome": "Fantasma",
  "categoria": "altro",
  "peso_g": 0
}
### Elimina oggetto - caso giusto (atteso 204)
DELETE {{base}}/api/oggetti/16

### Elimina oggetto - già eliminato (atteso 404)
DELETE {{base}}/api/oggetti/16

### Elimina oggetto - id non valido (atteso 400)
DELETE {{base}}/api/oggetti/abc