# =====================================================================
#  Variabili per "docker compose up".
#  Copia questo file in ".env" nella stessa cartella e metti valori veri:
#    Copy-Item .env.example .env        (PowerShell)
#  Il file .env NON va su git (è nel .gitignore): contiene i segreti.
# =====================================================================

# Chiave per firmare i token di login (JWT): lunga e casuale. Per generarne una:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=metti-qui-una-stringa-lunga-e-casuale

# Password dell'utente "loadout" del database.
# Vale solo quando il volume del database viene creato la prima volta:
# cambiarla dopo non cambia la password del database già esistente.
POSTGRES_PASSWORD=loadout_dev

# Facoltativa: altri siti che possono chiamare l'API dal browser (CORS), separati da virgole.
# Vuota = nessuno (il frontend di Loadout sta sullo stesso sito e non ne ha bisogno).
CORS_ORIGINS=

# Facoltativa: chiave di MapTiler per le mappe (piano gratuito: https://cloud.maptiler.com/account/keys/).
# Arriva al browser (le tessere le scarica lui): nel pannello di MapTiler limitala agli indirizzi dell'app
# (https://localhost, http://localhost:3000). Senza chiave l'app funziona, ma senza mappe.
MAPTILER_KEY=
